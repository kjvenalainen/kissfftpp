{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Bazel Build All (Debug)",
      "type": "shell",
      "command": "bazel build //src:all -c dbg",
      "windows": {
        "command": "bazel build //src:all --experimental_enable_runfiles -c dbg"
      },
      "osx": {
        "command": "bazel build //src:all -c dbg --spawn_strategy=local"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Bazel Build All (Run)",
      "type": "shell",
      "command": "bazel build //src:all",
      "windows": {
        "command": "bazel build //src:all"
      },
      "osx": {
        "command": "bazel build //src:all --spawn_strategy=local"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Bazel Build All (Optimized)",
      "type": "shell",
      "command": "bazel  build //src:all -c opt",
      "windows": {
        "command": "bazel build //src:all -c opt"
      },
      "osx": {
        "command": "bazel build //src:all -c opt --spawn_strategy=local"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Bazel Clean",
      "type": "shell",
      "command": "bazel clean",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Bazel Test (Verbose)",
      "type": "shell",
      "command": "bazel test //src:gtest --test_output=all",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Bazel Benchmark FFT Sizes",
      "type": "shell",
      "command": "bazel run //src:fftBenchmark -c opt",
      "group": {
        "kind": "test",
        "isDefault": false
      }
    }
  ]
}
